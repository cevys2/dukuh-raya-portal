# Same Railway Postgres connection string shipyard-pricing's backend uses
DATABASE_URL=

# MUST match shipyard-pricing backend's JWT_SECRET exactly - this is what
# lets a token from shipyard-pricing's /auth/login work here too.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
